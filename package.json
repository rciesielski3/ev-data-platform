{
  "name": "evsource",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "knip": "knip --include files,dependencies",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run build",
    "validate:quick": "npm run lint && npm run typecheck && npm run test",
    "verify:secrets": "tsx src/lib/config/verify-secrets-build.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "import:eipa": "tsx src/server/jobs/run-eipa-import.ts",
    "import:eipa:test": "EIPA_IMPORT_LIMIT=100 npm run import:eipa",
    "import:openev": "tsx src/server/jobs/run-openev-import.ts",
    "import:all": "npm run import:eipa && npm run import:openev",
    "fallback:refresh": "tsx src/server/jobs/build-fallback-snapshot.ts",
    "snapshot:backfill": "tsx src/server/jobs/backfill-snapshot.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@google-analytics/data": "^6.1.0",
    "@prisma/client": "^6.9.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/global-config": "1.5.1",
    "@vercel/speed-insights": "^2.0.0",
    "date-fns": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.24.0",
    "next": "^15.5.29",
    "next-intl": "^4.13.0",
    "react": "^19.3.0",
    "react-countup": "^6.5.3",
    "react-dom": "^19.3.0",
    "recharts": "^3.9.0",
    "simple-icons": "^16.34.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@swc/helpers": "^0.5.24",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.29.0",
    "eslint-config-next": "^15.5.27",
    "husky": "^9.1.7",
    "jsonwebtoken": "^9.0.3",
    "knip": "^6.45.1",
    "postcss": "^8.5.19",
    "prisma": "^6.9.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "effect": "^3.22.1",
    "postcss": "$postcss",
    "rimraf": "^6.1.4"
  }
}
