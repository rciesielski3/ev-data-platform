# Database
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname

# Neon API (production only)
NEON_API_KEY=your-api-key-here

# Google Analytics 4 (optional)
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Google Search Console API (service account credentials)
# See: https://developers.google.com/webmaster-tools/v1/getting_started#auth
GOOGLE_GSC_CREDENTIALS={"type":"service_account","project_id":"..."}
GOOGLE_GSC_SITE_URL=https://evsource.pl

# SEO Alert Recipients (comma-separated email addresses)
SEO_ALERT_EMAIL=r.ciesielski3@gmail.com

# Email Provider (optional: SendGrid, Resend, AWS SES, etc.)
# SENDGRID_API_KEY=your-sendgrid-key-here
